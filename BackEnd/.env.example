# Copia este archivo a `.env` y completá los valores.

# Token de autenticación de Turso (se obtiene en turso.tech → Database → Token)
TOKEN_TURSO=

# URL de la base de datos Turso (libsql://...) o local (file:./db.sqlite)
URL_TURSO=

# Puerto del servidor (por defecto 3000)
PORT=3000

# Días sugeridos entre contactos a una empresa (por defecto 30). Se usa para
# calcular postulaciones.proxima_contacto tras cada envío; una empresa puede
# sobreescribirlo con empresas.cadencia_contacto.
CADENCIA_CONTACTO_DIAS=30

# Entorno: development | production | test (por defecto development)
NODE_ENV=development

# Nivel de logs: debug | info | warn | error | silent
# (por defecto: debug en development, warn en production; silent apaga todo)
LOG_LEVEL=debug

# Pantalla de "fase de prueba" tras el login (true = el backend muestra el aviso
# y no redirige al frontend; false = redirige a FRONTEND_URL/auth/callback)
PANTALLA_BETA=true

# --- Google OAuth (por defecto vacías: el flujo requiere credenciales reales) ---

GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Debe coincidir exactamente con el "Authorized redirect URI" del OAuth Client
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Origen de la app frontend (adonde redirige tras el login)
FRONTEND_URL=http://localhost:5173

# Clave para firmar los JWT de sesión (usar una larga y aleatoria)
JWT_SECRET=una_clave_larga_y_segura