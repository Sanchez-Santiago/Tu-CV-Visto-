# Copia este archivo a `.env` y completá los valores.

# Token de autenticación de Turso (se obtiene en turso.tech → Database → Token)
TOKEN_TURSO=

# URL de la base de datos Turso (libsql://...) o local (file:./db.sqlite)
URL_TURSO=

# Puerto del servidor (por defecto 3000)
PORT=3000

# Días sugeridos entre contactos a una empresa (por defecto 30). Se usa para
# calcular postulaciones.proxima_contacto tras cada envío; una empresa puede
# sobreescribirlo con empresas.cadencia_contacto.
CADENCIA_CONTACTO_DIAS=30

# Entorno: development | production | test (por defecto development)
NODE_ENV=development

# Nivel de logs: debug | info | warn | error | silent
# (por defecto: debug en development, warn en production; silent apaga todo)
LOG_LEVEL=debug

# Pantalla de "fase de prueba" tras el login. Con FRONTEND_URL configurada el
# login SIEMPRE redirige a FRONTEND_URL/auth/callback#token=... (el JWT viaja en
# el fragmento); la pantalla beta solo aparece si PANTALLA_BETA=true y no hay
# FRONTEND_URL. En producción dejá estas dos bien configuradas.
PANTALLA_BETA=true

# --- Google OAuth (por defecto vacías: el flujo requiere credenciales reales) ---

GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Debe coincidir exactamente con el "Authorized redirect URI" del OAuth Client
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Origen de la app frontend (adonde redirige tras el login)
FRONTEND_URL=http://localhost:5173

# Clave para firmar los JWT de sesión (usar una larga y aleatoria)
JWT_SECRET=una_clave_larga_y_segura

# --- IA: cadena de proveedores con fallback (solo se corre on-demand) ---
# Orden de prioridad separado por comas. Si un proveedor falla (timeout,
# cuota, error), se prueba automáticamente con el siguiente.
IA_PROVEEDORES=gemini,groq,openrouter,openai,anthropic

# Google Gemini (tiene nivel gratuito en Google AI Studio).
# Si ningún proveedor tiene key, la clasificación usa solo keywords.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (secundaria gratuita, ~1000 req/día sin tarjeta).
# Key en https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (router `openrouter/free`: elige solo un modelo :free vigente).
# Los modelos gratuitos a veces devuelven el JSON con prosa alrededor:
# el backend lo tolera. Si un modelo falla mucho, pinneá un `:free`
# concreto de https://openrouter.ai/models (ej. google/gemma-4-26b-a4b-it:free).
# Key en https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (compatible también con OpenRouter, Together, Ollama/LM Studio
# cambiando OPENAI_BASE_URL).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (formato Messages API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ─────────────────────────────────────────────────────────────
# Valores de PRODUCCIÓN (Render + Netlify):
#   NODE_ENV=production
#   PANTALLA_BETA=false
#   FRONTEND_URL=https://cvisto.netlify.app          (sin "/" final)
#   GOOGLE_CALLBACK_URL=https://cvisto.onrender.com/auth/google/callback
#   Netlify (frontend): VITE_API_URL=https://cvisto.onrender.com
# ─────────────────────────────────────────────────────────────